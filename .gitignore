# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ============ IELTS Study OS — user data & privacy ============
# Local SQLite database (user progress, settings, vocabulary, mistakes)
/data/

# User recordings, uploads and imported materials (NEVER commit these)
/data/uploads/
recordings/
uploads/

# Locally generated TTS audio / practice content
content/generated/

# Playwright browser artifacts
/blob-report/
