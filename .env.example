# ============================================================
# IELTS Study OS — environment configuration
# All values are OPTIONAL. The application runs fully without any API key.
# Copy this file to .env and fill in only what you need.
# API keys are server-side only and NEVER exposed to the browser.
# ============================================================

# ---- AI provider (OpenAI-compatible) ----
# Any OpenAI-compatible endpoint works: OpenAI, DeepSeek, OpenRouter, xAI,
# Google (via OpenAI-compat), or a local server (LM Studio, Ollama, vLLM).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- Speech (all optional) ----
# Speech-to-text (OpenAI-compatible transcription endpoint)
STT_API_KEY=
STT_BASE_URL=http://localhost:9000
STT_MODEL=whisper-1

# Pronunciation assessment provider key (optional)
PRONUNCIATION_API_KEY=

# ---- Database ----
# Optional: override the SQLite database path
# IELTS_DB_PATH=

# ---- Runtime ----
# Comma-separated list of allowed origins (optional; defaults to same-origin)
# ALLOWED_ORIGINS=
